# PostgreSQL (Neon, Supabase, Railway o local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devboard"

# Clerk — habilita GitHub (y Google) en Dashboard → SSO Connections
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Pusher Channels (canales privados; no hace falta activar client events)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# Email del primer admin para el seed (se enlaza al hacer login con ese email)
SEED_ADMIN_EMAIL=tu-email@ejemplo.com
